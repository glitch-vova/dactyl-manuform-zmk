#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define RAISE   1
#define LOWER   2

/ {
    behaviors {
        letter_T_behavior: letter_T_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "LETTER_T_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            // Right half, without the thumb cluster.
            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                50 51
            >;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            // Left half, without the thumb cluster.
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            // Commented layout is not actual layout.
            // -------------------------------------------------------------------------------------------------------------------------
            // |   ESC   |    1    |    2    |    3    |    4    |    5    |                   |    6    |    7    |    8    |    9    |    0    |  BSPC   |
            // |   TAB   |    Q    |    W    |    E    |    R    |    T    |                   |    Y    |    U    |    I    |    O    |    P    |    \    |
            // |  LALT   |    A    |    S    |    D    |    F    |    G    |                   |    H    |    J    |    K    |    L    |    ;    |    '    |
            // |  LCTRL  |    Z    |    X    |    C    |    V    |    B    |                   |    N    |    M    |    ,    |    .    |    /    |  RALT   |
            //                     |    [    |    ]    |                                                           |    -    |    =    |
            //                               | MO lay 1| SPACE   |                   | ENTER   | MO lay 2|
            //                                         |   TAB   |   HOME  |   END   |   DEL   |
            //                                         |  Raise  |    ~    |   GUI   |  Lower  |

            bindings = <
&kp GRAVE                             &kp N1        &kp N2           &kp N3       &kp N4              &kp N5                                           &kp N6                &kp N7                   &kp N8     &kp N9     &kp N0         &kp RIGHT_BRACKET
&kp TAB                               &kp Q         &kp W            &kp E        &kp R               &kp T                                            &kp Y                 &kp U                    &kp I      &kp O      &kp P          &kp LEFT_BRACKET
&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &hml LCTRL A  &hml LEFT_ALT S  &hml LCMD D  &hml LEFT_SHIFT F   &kp G                                            &kp H                 &hmr RSHFT J             &hmr RCMD K &hmr RIGHT_ALT L &hmr RCTRL SEMICOLON &kp SQT
&kp LSHIFT                            &kp Z         &kp X            &kp C        &kp V               &kp B                                            &kp N                 &kp M                    &kp COMMA  &kp DOT    &kp FSLH       &kp BACKSLASH
                                                    &kp LEFT         &kp RIGHT                                                                                                                        &kp MINUS  &kp EQUAL
                                                                                  &mt LGUI BACKSPACE  &mt LEFT_SHIFT SPACE                             &mt RSHFT ENTER       &mt RIGHT_GUI BACKSPACE
                                                                                                      &kp LEFT_ALT          &lt 2 KP_ENTER  &lt 1 F16  &mt RIGHT_ALT DELETE
                                                                                                      &kp LCTRL             &kp ESCAPE      &kp LCTRL  &kp C_AC_SEARCH
            >;
        };

        raise {
            display-name = "Raise";
            // commented layout is not actual layout.
            // -------------------------------------------------------------------------------------------------------------------------
            // |   esc   |    1    |    2    |    3    |    4    |    5    |                   |    6    |    7    |    8    |    9    |    0    |  bspc   |
            // |   tab   |    q    |    w    |    e    |    r    |    t    |                   |    y    |    u    |    i    |    o    |    p    |    \    |
            // |  lalt   |    a    |    s    |    d    |    f    |    g    |                   |    h    |    j    |    k    |    l    |    ;    |    '    |
            // |  lctrl  |    z    |    x    |    c    |    v    |    b    |                   |    n    |    m    |    ,    |    .    |    /    |  ralt   |
            //                     |    [    |    ]    |                                                           |    -    |    =    |
            //                               | mo lay 1| space   |                   | enter   | mo lay 2|
            //                                         |   tab   |   home  |   end   |   del   |
            //                                         |  raise  |    ~    |   gui   |  lower  |

            bindings = <
&kp LS(GRAVE)  &kp LS(NUMBER_1)  &kp LG(F2)  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                         &kp C_VOLUME_DOWN  &kp C_VOLUME_UP      &kp LS(NUMBER_8)     &kp LS(NUMBER_9)     &kp LS(NUMBER_0)  &bootloader
&trans         &trans            &trans      &trans                                  &trans            &kp LEFT_BRACKET                         &kp RBKT           &kp LG(KP_NUMBER_7)  &kp LG(KP_NUMBER_8)  &kp LG(KP_NUMBER_9)  &kp KP_DIVIDE     &kp KP_ASTERISK
&trans         &kp HOME          &kp PG_UP   &kp PG_DN                               &kp END           &kp LPAR                                 &kp RPAR           &kp LG(KP_NUMBER_4)  &kp LG(KP_NUMBER_5)  &kp LG(KP_NUMBER_6)  &kp KP_SUBTRACT   &kp PIPE
&trans         &trans            &trans      &trans                                  &trans            &kp LEFT_BRACE                           &kp RIGHT_BRACE    &kp LG(KP_NUMBER_1)  &kp LG(KP_NUMBER_2)  &kp LG(KP_NUMBER_3)  &kp KP_PLUS       &sys_reset
                                 &trans      &kp PSCRN                                                                                                                                  &kp KP_NUMBER_0      &kp KP_DOT
                                                                                     &trans            &trans                                   &trans             &trans
                                                                                                       &bt BT_DISC 1     &bt BT_DISC 0  &trans  &studio_unlock
                                                                                                       &bt BT_DISC 3     &bt BT_DISC 2  &trans  &trans
            >;
        };

        lower {
            display-name = "Lower";
            // commented layout is not actual layout.
            // -------------------------------------------------------------------------------------------------------------------------
            // |   esc   |    1    |    2    |    3    |    4    |    5    |                   |    6    |    7    |    8    |    9    |    0    |  bspc   |
            // |   tab   |    q    |    w    |    e    |    r    |    t    |                   |    y    |    u    |    i    |    o    |    p    |    \    |
            // |  lalt   |    a    |    s    |    d    |    f    |    g    |                   |    h    |    j    |    k    |    l    |    ;    |    '    |
            // |  lctrl  |    z    |    x    |    c    |    v    |    b    |                   |    n    |    m    |    ,    |    .    |    /    |  ralt   |
            //                     |    [    |    ]    |                                                           |    -    |    =    |
            //                               | mo lay 1| space   |                   | enter   | mo lay 2|
            //                                         |   tab   |   home  |   end   |   del   |
            //                                         |  raise  |    ~    |   gui   |  lower  |

            bindings = <
&bootloader  &kp F1    &kp F2            &kp F3        &kp F4     &kp F5                                      &kp F6                     &kp F7           &kp F8           &kp F9           &kp F10       &kp F11
&trans       &trans    &kp LG(UP_ARROW)  &kp LG(DOWN)  &trans     &kp LA(LEFT_BRACKET)                        &kp LS(LA(RIGHT_BRACKET))  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH  &kp KP_MULTIPLY
&trans       &kp LEFT  &kp UP            &kp DOWN      &kp RIGHT  &kp LEFT_PARENTHESIS                        &kp RIGHT_PARENTHESIS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &trans
&sys_reset   &trans    &trans            &trans        &trans     &kp LEFT_BRACE                              &kp RIGHT_BRACE            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS   &kp K_COPY
                       &kp COMMA         &kp PERIOD                                                                                                       &kp KP_NUMBER_0  &kp KP_DOT
                                                       &trans     &trans                                      &bt BT_CLR_ALL             &bt BT_CLR
                                                                  &trans                &trans  &bt BT_SEL 0  &bt BT_SEL 1
                                                                  &trans                &trans  &bt BT_SEL 2  &bt BT_SEL 3
            >;
        };

        extra_1 {
            status = "reserved";
            display-name = "Extra 1";
        };

        extra_2 {
            status = "reserved";
            display-name = "Extra 2";
        };
    };
};
